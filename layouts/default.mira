}

/* Mira Reusable Components: Button, Highlight, Eyebrow, Chip, Box */
.mira-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  height: 44px;
  padding: 0 var(--space-6);
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  font: 500 15px/1 var(--font-text);
  letter-spacing: -0.005em;
  text-decoration: none;
  cursor: pointer;
  transition: transform 420ms var(--mira-spring), background-color 160ms, border-color 160ms, box-shadow 200ms;
}
.mira-btn[data-size="sm"] { height: 32px; padding: 0 var(--space-4); font-size: 13px; }
.mira-btn[data-variant="solid"] { background: var(--fill-ink); color: var(--on-fill-ink); }
.mira-btn[data-variant="outline"] { background: transparent; color: var(--ink); border-color: var(--line-strong); }
.mira-btn[data-variant="accent"] { background: var(--ember); color: var(--on-warm); }
.mira-btn:hover { transform: translateY(-2px); }
.mira-btn[data-variant="outline"]:hover { border-color: var(--ink); }
.mira-btn[data-variant="accent"]:hover { box-shadow: var(--glow-ember); }
.mira-btn:active { transform: translateY(0) scale(0.98); }
.mira-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

.mira-eyebrow {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.6em;
  font: 500 12px/1.4 var(--font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-muted);
}

.mira-hl {
  position: relative;
  display: inline-block;
  padding: 0 0.16em;
  border-radius: var(--radius-px);
  background: var(--sun);
  color: var(--on-warm);
  line-height: 1.02;
}
.mira-hl[data-tone="ember"] { background: var(--ember); }
.mira-hl[data-tone="lime"] { background: var(--lime); }
.mira-hl[data-tone="cobalt"] { background: var(--cobalt); color: var(--on-cool); }
.mira-hl > i {
  position: absolute;
  width: 9px;
  height: 9px;
  background: var(--navy);
  border: 1px solid var(--haze);
  border-radius: var(--radius-px);
}
.mira-hl > i:nth-of-type(1) { left: -5px; top: -5px; }
.mira-hl > i:nth-of-type(2) { right: -5px; top: -5px; }
.mira-hl > i:nth-of-type(3) { left: -5px; bottom: -5px; }
.mira-hl > i:nth-of-type(4) { right: -5px; bottom: -5px; }

.mira-chip {
  display: inline-flex;
  align-items: center;
  height: 26px;
  padding: 0 var(--space-3);
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--surface-2);
  color: var(--ink);
  font: 500 12px/1 var(--font-mono);
  white-space: nowrap;
}
.mira-chip[data-mono="false"] { font-family: var(--font-text); }

/* Pixel icon */
.mira-pxi {
  --pxi: var(--ink);
  display: block;
  flex: none;
}
.mira-pxi rect {
  fill: var(--pxi);
  fill-opacity: 0.14;
}
.mira-pxi rect.on {
  fill-opacity: 1;
}
.mira-pxi[data-tone="ember"] { --pxi: var(--ember); }
.mira-pxi[data-tone="sun"] { --pxi: var(--sun); }
.mira-pxi[data-tone="peach"] { --pxi: var(--peach); }
.mira-pxi[data-tone="rose"] { --pxi: var(--rose); }
.mira-pxi[data-tone="lime"] { --pxi: var(--lime); }
.mira-pxi[data-tone="lagoon"] { --pxi: var(--lagoon); }
.mira-pxi[data-tone="haze"] { --pxi: var(--haze); }
.mira-pxi[data-tone="lilac"] { --pxi: var(--lilac); }
.mira-pxi[data-tone="cobalt"] { --pxi: var(--cobalt); }

/* Boxed Layout with 4 selection handles */
.mira-box {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--radius-box);
  background: var(--surface-0);
}
.mira-box > i {
  position: absolute;
  z-index: 2;
  width: 14px;
  height: 14px;
  border: 1px solid var(--line-strong);
  border-radius: 3px;
  background: var(--surface-0);
  pointer-events: none;
}
.mira-box > i:nth-of-type(1) { left: -8px; top: -8px; }
.mira-box > i:nth-of-type(2) { right: -8px; top: -8px; }
.mira-box > i:nth-of-type(3) { left: -8px; bottom: -8px; }
.mira-box > i:nth-of-type(4) { right: -8px; bottom: -8px; }

.mira-cells {
  --mira-cols: 3;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(var(--mira-cols), minmax(0, 1fr));
  gap: 1px;
  background: var(--line);
}
.mira-cells[data-cols="2"] { --mira-cols: 2; }
.mira-cells[data-cols="3"] { --mira-cols: 3; }
.mira-cells[data-cols="4"] { --mira-cols: 4; }

.mira-cell {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-8) var(--space-6);
  background: var(--surface-1);
  transition: background 0.15s ease;
}

.mira-cell:hover {
  background: var(--surface-2);
}

@media (max-width: 768px) {
  .mira-cells[data-cols="3"],
  .mira-cells[data-cols="4"] {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .mira-header__inner {
    padding-inline: var(--space-3);
  }
  mira-search {
    width: 130px;
  }
  .mira-footer__top {
    flex-direction: column;
    gap: var(--space-4);
  }
